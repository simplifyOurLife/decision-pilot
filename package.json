{
  "name": "@simplifyourlife/decision-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "decision-pilot": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && esbuild src/mcp/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=plugins/decision-pilot/mcp/server.bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
